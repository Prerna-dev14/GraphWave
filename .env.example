# GraphWeave (GWeave) Environment Configuration
# Copy this file to .env for local development

# Application
APP_NAME=GraphWeave
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
SECRET_KEY=dev-insecure-secret-key-change-in-production

# Multi-Tenancy & Corpus Defaults
DEFAULT_TENANT_ID=tenant-default
DEFAULT_CORPUS_ID=corpus-primary

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=graphweave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/graphweave

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphweave_secret
NEO4J_DATABASE=neo4j

# LLM & Embedding Adapter Configuration
# Supported providers: "mock", "openai", "azure_openai", "ollama"
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# LLM Model Credentials & Settings (leave blank for mock provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Graph Traversal Bounds & Query Budgets
MAX_TRAVERSAL_DEPTH=2
MAX_FAN_OUT=15
TRAVERSAL_TIMEOUT_SECONDS=5.0
QUERY_BUDGET_MAX_NODES=100
CONFIDENCE_THRESHOLD=0.65

# Feature Flags
ENABLE_MOCK_FALLBACK=true
ENABLE_DETAILED_TELEMETRY=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
